// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Essay {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  name        String
  description String
  image_url   String
}

model Edu_content {
  id        Int          @id @default(autoincrement())
  createdAt DateTime     @default(now())
  title     String
  link      String
  image     String
  content   String
  category  Categories[] @relation(name: "content")
  likes     Int          @default(0)
}

model Categories {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  name      String        @unique
  content   Edu_content[] @relation(name: "content")
}

model Quiz {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  title     String
  url       String
  setActive Boolean  @default(false)
}

model AlertMessage {
  id      Int    @id @default(autoincrement())
  message String
}

model User {
  id                   Int      @id @default(autoincrement())
  JoinedAt             DateTime @default(now())
  name                 String
  email                String
  username             String   @unique
  salt                 String
  hash                 String
  role                 String
  recieveNotifications Boolean
}


model Cv {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  name          String
  Image         String
  Description   String
  Introduction  String
  Education     Education[] @relation(name: "Education")
  researchList  Research[] @relation(name: "Researches")
  Experience    Experience[] @relation(name: "Experience")
}


model Research {
  id        Int      @id @default(autoincrement())
  Researches   Cv[] @relation(name: "Researches")
  title     String
  link      String
  image     String
  content   String
  file      String
}

model Experience {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  Experience   Cv[] @relation(name: "Experience")
  title     String
  link      String
  image     String
  content   String
}

model Education {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  Education   Cv[] @relation(name: "Education")
  title     String
  link      String
  image     String
  content   String
}